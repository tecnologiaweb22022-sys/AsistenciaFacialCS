<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Restaurante inteligente con visión artificial — IAR-600
    Aplicación Windows Forms (.NET 8) que además levanta un servidor web local
    para los celulares de los clientes. Funciona sin internet.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>AsistenciaFacial</RootNamespace>
    <AssemblyName>AsistenciaFacial</AssemblyName>
    
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <Product>Asistencia facial IAR-600</Product>
    <Company>IAR-600 Inteligencia Artificial y Robótica</Company>
  </PropertyGroup>

  <ItemGroup>
    
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.11.0.20250507" />
    
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <!-- Solo para importar una vez los datos del antiguo datos/asistencia.db (SQLite) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="modelos\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
